```gitignore
# Dependencies
node_modules/

# Runtime state
data/*
!data/.gitkeep

# Session backups
backups/*
!backups/.gitkeep

# Environment files
.env
.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp
```
